<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Texnomic.Curl.Impersonate.Runtime.linux-x64</PackageId>
    <Description>Native libcurl-impersonate binaries for the linux-x64 runtime, consumed transitively by Texnomic.Curl.Impersonate. Not intended for direct use.</Description>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Pack="true" + PackagePath ships the natives inside the NuGet at
    runtimes/<rid>/native/, the path NuGet's runtime asset resolver looks
    up at execution time.
    For <ProjectReference> consumers NuGet's runtime asset selection does
    not run, so Link flattens the file into the consumer's bin root
    (next to Texnomic.Curl.Impersonate.dll). The native loader searches
    the directory of the calling managed assembly, so a flat layout works
    without a deps.json runtimeTargets entry.
  -->
  <ItemGroup>
    <None Include="runtimes\linux-x64\native\libcurl-impersonate.so"
          Pack="true"
          PackagePath="runtimes\linux-x64\native\libcurl-impersonate.so"
          Link="libcurl-impersonate.so"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
