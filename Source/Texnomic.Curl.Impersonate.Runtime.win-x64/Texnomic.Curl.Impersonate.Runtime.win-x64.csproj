<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Texnomic.Curl.Impersonate.Runtime.win-x64</PackageId>
    <Description>Native libcurl-impersonate binaries for the win-x64 runtime, consumed transitively by Texnomic.Curl.Impersonate. Not intended for direct use.</Description>

    <!-- Native-only meta package: no managed code, no compile, no symbols. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn> <!-- no managed dependency group -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Pack="true" + PackagePath ships the natives inside the NuGet at
    runtimes/<rid>/native/, the path NuGet's runtime asset resolver looks
    up at execution time.
    For <ProjectReference> consumers NuGet's runtime asset selection does
    not run, so Link flattens the file into the consumer's bin root
    (next to Texnomic.Curl.Impersonate.dll). The native loader searches
    the directory of the calling managed assembly, so a flat layout works
    without a deps.json runtimeTargets entry.
  -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\libcurl-impersonate.dll"
          Pack="true"
          PackagePath="runtimes\win-x64\native\libcurl-impersonate.dll"
          Link="libcurl-impersonate.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      zlib.dll was dropped with the v2.2.3 upgrade. The build statically links
      zlib (as well as zstd and brotli); the DLL's import table names only
      Windows system libraries — advapi32, crypt32, iphlpapi, kernel32,
      normaliz, ntdll and ws2_32 — so there is nothing left to satisfy.
    -->
  </ItemGroup>

</Project>
